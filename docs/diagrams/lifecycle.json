{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "One task, start to finish",
    "quality_profile": "showcase",
    "output": "lifecycle.html",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "main",
      "label": "Task"
    },
    {
      "id": "fixing",
      "label": "Fix rounds"
    },
    {
      "id": "terminal",
      "label": "Outcome"
    }
  ],
  "states": [
    {
      "id": "planned",
      "type": "start",
      "label": "Planned",
      "lane": "main",
      "col": 0,
      "width": 110,
      "sublabel": "in the plan"
    },
    {
      "id": "building",
      "type": "active",
      "label": "Building",
      "lane": "main",
      "col": 1,
      "width": 110,
      "sublabel": "implementer"
    },
    {
      "id": "review",
      "type": "decision",
      "label": "Review",
      "lane": "main",
      "col": 2,
      "width": 110,
      "sublabel": "reviewer"
    },
    {
      "id": "fix",
      "type": "waiting",
      "label": "Fix",
      "lane": "fixing",
      "col": 2,
      "width": 110,
      "sublabel": "round 1 or 2"
    },
    {
      "id": "done",
      "type": "success",
      "label": "Done",
      "lane": "terminal",
      "col": 1,
      "width": 110,
      "sublabel": "approved"
    },
    {
      "id": "blocked",
      "type": "failure",
      "label": "Blocked",
      "lane": "terminal",
      "col": 2,
      "width": 110,
      "sublabel": "still failing"
    }
  ],
  "transitions": [
    {
      "from": "planned",
      "to": "building"
    },
    {
      "from": "building",
      "to": "review"
    },
    {
      "from": "review",
      "to": "done",
      "variant": "emphasis",
      "label": "approve"
    },
    {
      "from": "review",
      "to": "fix",
      "variant": "security",
      "label": "fix-needed"
    },
    {
      "from": "fix",
      "to": "review",
      "variant": "dashed",
      "label": "re-review"
    },
    {
      "from": "fix",
      "to": "blocked",
      "variant": "security",
      "label": "after 2 rounds"
    }
  ]
}
